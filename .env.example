# ===== PRISMA GEF — variáveis de ambiente (NÃO coloque valores reais aqui) =====

# --- Vercel (frontend + proxy /api) ---------------------------------------
# Firebase Web App: identificadores públicos do app, exigidos no BUILD
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=prisma-gef.firebaseapp.com
FIREBASE_PROJECT_ID=prisma-gef
FIREBASE_STORAGE_BUCKET=prisma-gef.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# URL HTTPS do backend no Render, sem barra final (usada pelo proxy api/_proxy.js)
PRISMA_BACKEND_URL=https://prisma-gef-api.onrender.com
# Opcional: força o front a chamar outra API (vazio = mesmo domínio via proxy)
PRISMA_API_URL=
# Opcional: libera GET /api/debug-env com o cabeçalho x-debug-token
DEBUG_ENV_TOKEN=

# --- Render (backend Node + SQLite) ----------------------------------------
NODE_ENV=production
PORT=10000
DB_PATH=/var/data/prisma.sqlite
BACKUP_DIR=/var/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
TRUST_PROXY_HOPS=2
SESSION_TTL_DAYS=30
# Origens permitidas (CORS/CSRF), separadas por vírgula — domínio(s) da Vercel
ALLOWED_ORIGINS=https://seu-app.vercel.app
# URL pública do frontend (links de redefinição de senha)
APP_BASE_URL=https://seu-app.vercel.app
# Projeto Firebase cujos ID tokens o backend aceita
FIREBASE_PROJECT_ID=prisma-gef
# Administrador inicial (opcional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# E-mail (envio de PDFs / reset) — opcional
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=Prisma GEF
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Limites opcionais
WAF_API_RATE_MAX=120
WAF_AUTH_RATE_MAX=20
PDF_SEND_PER_MINUTE=3
PDF_SEND_PER_DAY=20
